<?xml version="1.0"?>
<robot name="5dof_robot_arm">
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="shoulder_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="upper_arm_link">
        <visual>
            <geometry>
                <box size="0.2 0.05 0.05"/>
            </geometry>
            <origin xyz="0.1 0 0" rpy="0 0 0"/>
            <material name="red">
                <color rgba="0.8 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="forearm_link">
        <visual>
            <geometry>
                <box size="0.2 0.05 0.05"/>
            </geometry>
            <origin xyz="0.1 0 0" rpy="0 0 0"/>
            <material name="green">
                <color rgba="0.0 0.8 0.0 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="wrist_link">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="purple">
                <color rgba="0.5 0.0 0.5 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="hand_link">
        <visual>
            <geometry>
                <box size="0.12 0.04 0.04"/>
            </geometry>
            <origin xyz="0.06 0 0" rpy="0 0 0"/>
            <material name="yellow">
                <color rgba="0.8 0.8 0.0 1.0"/>
            </material>
        </visual>
    </link>
    
    <joint name="base_shoulder_joint" type="revolute">
        <parent link="base_link"/>
        <child link="shoulder_link"/>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    </joint>
    
    <joint name="shoulder_upper_arm_joint" type="revolute">
        <parent link="shoulder_link"/>
        <child link="upper_arm_link"/>
        <origin xyz="0 0 0.1" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>
    
    <joint name="upper_arm_forearm_joint" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>
        <origin xyz="0.2 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>
    
    <joint name="forearm_wrist_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="wrist_link"/>
        <origin xyz="0.2 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>
    
    <joint name="wrist_hand_joint" type="revolute">
        <parent link="wrist_link"/>
        <child link="hand_link"/>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    </joint>
</robot> 
